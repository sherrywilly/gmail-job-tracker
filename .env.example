ENVIRONMENT=dev
APP_NAME=gmail-job-tracker

# Security
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database / Queue
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gmail_job_tracker
REDIS_URL=redis://localhost:6379/0

# Database bootstrap (dev only)
AUTO_CREATE_TABLES=true

# OpenAI / LangChain (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gmail API (optional)
# Provide these as JSON strings (recommended) OR leave empty to disable Gmail sync.
GMAIL_CLIENT_SECRET_JSON=
GMAIL_TOKEN_JSON=

# Comma-separated scopes, default is readonly + modify for marking read/unread
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.modify

# Poll interval for periodic sync (Celery beat)
GMAIL_POLL_INTERVAL_MINUTES=10

# Daily digest schedule (UTC)
DAILY_DIGEST_HOUR_UTC=8
